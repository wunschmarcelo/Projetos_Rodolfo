        function renderGrid(containerId, gridData, foundSet, targetWords) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            gridData.forEach((row, rIdx) => {
                row.forEach((char, cIdx) => {
                    const cell = document.createElement('div');
                    cell.className = 'WORD-CELL';
                    cell.textContent = char;
                    cell.dataset.row = rIdx;
                    cell.dataset.char = char;
                    
                    cell.addEventListener('click', () => {
                        cell.classList.toggle('FOUND');
                        checkWordSearch(containerId, gridData, foundSet, targetWords);
                    });
                    
                    container.appendChild(cell);
                });
            });
        }

        function checkWordSearch(containerId, gridData, foundSet, targetWords) {
            targetWords.forEach(wordObj => {
                let isWordFound = true;
                for (let c = wordObj.startCol; c <= wordObj.endCol; c++) {
                    const cells = document.querySelectorAll(`#${containerId} .WORD-CELL`);
                    const cellIndex = wordObj.row * 8 + c;
                    if (!cells[cellIndex].classList.contains('FOUND')) {
                        isWordFound = false;
                        break;
                    }
                }

                if (isWordFound) {
                    foundSet.add(wordObj.name);
                    const wbItem = document.getElementById(`WB-${wordObj.name}`);
                    if (wbItem) wbItem.classList.add('DONE');
                }
            });
