<!DOCTYPE html>
<html LANG="PT-BR">
<head>
    <meta CHARSET="UTF-8">
    <meta NAME="VIEWPORT" CONTENT="WIDTH=DEVICE-WIDTH, INITIAL-SCALE=1.0">
    <title>OFICINA DIGITAL - 2º ANO</title>
    <style>
        :root {
            --PRIMARY-COLOR: #4F46E5;
            --SECONDARY-COLOR: #0284C7;
            --SUCCESS-COLOR: #16A34A;
            --DANGER-COLOR: #DC2626;
            --BG-COLOR: #F1F5F9;
            --CARD-BG: #FFFFFF;
            --TEXT-COLOR: #0F172A;
            --BORDER-COLOR: #CBD5E1;
            --DISABLED-COLOR: #94A3B8;
        }

        * {
            BOX-SIZING: BORDER-BOX;
            MARGIN: 0;
            PADDING: 0;
            FONT-FAMILY: 'SEGOE UI', TAHOMA, GENEVA, VERDANA, SANS-SERIF;
            TEXT-TRANSFORM: UPPERCASE;
        }

        BODY {
            BACKGROUND-COLOR: VAR(--BG-COLOR);
            COLOR: VAR(--TEXT-COLOR);
            DISPLAY: FLEX;
            JUSTIFY-CONTENT: CENTER;
            PADDING: 1.5REM 1REM;
            LINE-HEIGHT: 1.5;
        }

        .CONTAINER {
            WIDTH: 100%;
            MAX-WIDTH: 850PX;
            BACKGROUND-COLOR: VAR(--CARD-BG);
            BORDER-RADIUS: 12PX;
            BOX-SHADOW: 0 10PX 15PX -3PX RGBA(0, 0, 0, 0.1);
            PADDING: 1.5REM;
        }

        HEADER {
            MARGIN-BOTTOM: 1.5REM;
            TEXT-ALIGN: CENTER;
        }

        HEADER H1 {
            COLOR: VAR(--PRIMARY-COLOR);
            FONT-SIZE: 1.6REM;
            MARGIN-BOTTOM: 0.5REM;
        }

        HEADER P {
            COLOR: #64748B;
            FONT-SIZE: 1REM;
            FONT-WEIGHT: BOLD;
        }

        /* BARRA DE PROGRESSO */
        .PROGRESS-CONTAINER {
            WIDTH: 100%;
            BACKGROUND-COLOR: #E2E8F0;
            BORDER-RADIUS: 8PX;
            HEIGHT: 12PX;
            MARGIN-BOTTOM: 1.5REM;
            OVERFLOW: HIDDEN;
        }

        .PROGRESS-BAR {
            HEIGHT: 100%;
            WIDTH: 0%;
            BACKGROUND-COLOR: VAR(--PRIMARY-COLOR);
            TRANSITION: WIDTH 0.4S EASE;
        }

        /* NAVEGAÇÃO EM 5 ABAS */
        .TABS-NAV {
            DISPLAY: FLEX;
            GAP: 0.5REM;
            BORDER-BOTTOM: 2PX SOLID VAR(--BORDER-COLOR);
            MARGIN-BOTTOM: 1.5REM;
            OVERFLOW-X: AUTO;
        }

        .TAB-BTN {
            PADDING: 0.75REM 1REM;
            BORDER: NONE;
            BACKGROUND: NONE;
            FONT-SIZE: 0.95REM;
            FONT-WEIGHT: 700;
            COLOR: VAR(--DISABLED-COLOR);
            CURSOR: NOT-ALLOWED;
            BORDER-BOTTOM: 3PX SOLID TRANSPARENT;
            TRANSITION: ALL 0.3S EASE;
            WHITE-SPACE: NOWRAP;
        }

        .TAB-BTN.UNLOCKED {
            COLOR: VAR(--TEXT-COLOR);
            CURSOR: POINTER;
        }

        .TAB-BTN.ACTIVE {
            COLOR: VAR(--PRIMARY-COLOR);
            BORDER-BOTTOM-COLOR: VAR(--PRIMARY-COLOR);
        }

        .TAB-BTN.COMPLETED {
            COLOR: VAR(--SUCCESS-COLOR);
        }

        /* CONTEÚDO DAS ABAS */
        .TAB-CONTENT {
            DISPLAY: NONE;
        }

        .TAB-CONTENT.ACTIVE {
            DISPLAY: BLOCK;
            ANIMATION: FADEIN 0.4S EASE;
        }

        @KEYFRAMES FADEIN {
            FROM { OPACITY: 0; TRANSFORM: TRANSLATEY(5PX); }
            TO { OPACITY: 1; TRANSFORM: TRANSLATEY(0); }
        }

        .ACTIVITY-BOX {
            BACKGROUND-COLOR: #F8FAFC;
            BORDER: 2PX SOLID VAR(--BORDER-COLOR);
            PADDING: 1.2REM;
            BORDER-RADIUS: 10PX;
            MARGIN-TOP: 1REM;
            MARGIN-BOTTOM: 1REM;
        }

        .TAG-THEME {
            DISPLAY: INLINE-BLOCK;
            PADDING: 0.3REM 0.6REM;
            BORDER-RADIUS: 6PX;
            FONT-SIZE: 0.85REM;
            FONT-WEIGHT: BOLD;
            TEXT-TRANSFORM: UPPERCASE;
            MARGIN-BOTTOM: 0.5REM;
        }

        .TAG-SEGURANCA { BACKGROUND-COLOR: #E0F2FE; COLOR: #0369A1; }
        .TAG-NEPRE { BACKGROUND-COLOR: #FCE7F3; COLOR: #BE185D; }
        .TAG-FOLCLORE { BACKGROUND-COLOR: #FEF3C7; COLOR: #B45309; }
        .TAG-REVISAO { BACKGROUND-COLOR: #DCFCE7; COLOR: #15803D; }
        .TAG-AGRUPA { BACKGROUND-COLOR: #F3E8FF; COLOR: #7E22CE; }

        .TEXT-CARD-LIST {
            DISPLAY: FLEX;
            FLEX-DIRECTION: COLUMN;
            GAP: 1REM;
            MARGIN-BOTTOM: 1.2REM;
        }

        .TEXT-CARD {
            BACKGROUND-COLOR: #FFFFFF;
            BORDER-LEFT: 6PX SOLID VAR(--PRIMARY-COLOR);
            BORDER-TOP: 1PX SOLID VAR(--BORDER-COLOR);
            BORDER-RIGHT: 1PX SOLID VAR(--BORDER-COLOR);
            BORDER-BOTTOM: 1PX SOLID VAR(--BORDER-COLOR);
            PADDING: 1REM;
            BORDER-RADIUS: 0 8PX 8PX 0;
        }

        .TEXT-CARD.NEPRE-CARD { BORDER-LEFT-COLOR: #BE185D; }
        .TEXT-CARD.FOLCLORE-CARD { BORDER-LEFT-COLOR: #B45309; }
        .TEXT-CARD.REVISAO-CARD { BORDER-LEFT-COLOR: #15803D; }
        .TEXT-CARD.AGRUPA-CARD { BORDER-LEFT-COLOR: #7E22CE; }

        .TEXT-CARD H4 {
            COLOR: VAR(--PRIMARY-COLOR);
            MARGIN-BOTTOM: 0.3REM;
            FONT-SIZE: 1REM;
        }

        .TEXT-CARD.NEPRE-CARD H4 { COLOR: #BE185D; }
        .TEXT-CARD.FOLCLORE-CARD H4 { COLOR: #B45309; }
        .TEXT-CARD.REVISAO-CARD H4 { COLOR: #15803D; }
        .TEXT-CARD.AGRUPA-CARD H4 { COLOR: #7E22CE; }

        .TEXT-CARD P {
            FONT-SIZE: 1REM;
            COLOR: #1E293B;
            FONT-WEIGHT: 600;
            LINE-HEIGHT: 1.6;
        }

        TEXTAREA, INPUT[TYPE="TEXT"], SELECT {
            WIDTH: 100%;
            PADDING: 0.8REM;
            BORDER: 2PX SOLID VAR(--BORDER-COLOR);
            BORDER-RADIUS: 8PX;
            MARGIN-TOP: 0.5REM;
            FONT-SIZE: 1REM;
            FONT-WEIGHT: BOLD;
            TEXT-TRANSFORM: UPPERCASE;
            BACKGROUND-COLOR: #FFFFFF;
        }

        TEXTAREA {
            RESIZE: VERTICAL;
            MIN-HEIGHT: 60PX;
        }

        /* ESTILOS PARA CAÇA-PALAVRAS INTERATIVO */
        .WORD-GRID {
            DISPLAY: GRID;
            GRID-TEMPLATE-COLUMNS: REPEAT(8, 1FR);
            GAP: 5PX;
            MAX-WIDTH: 360PX;
            MARGIN: 1REM AUTO;
        }

        .WORD-CELL {
            BACKGROUND: #FFFFFF;
            BORDER: 2PX SOLID VAR(--PRIMARY-COLOR);
            BORDER-RADIUS: 6PX;
            TEXT-ALIGN: CENTER;
            FONT-SIZE: 1.2REM;
            FONT-WEIGHT: BOLD;
            PADDING: 0.5REM 0;
            CURSOR: POINTER;
            USER-SELECT: NONE;
            TRANSITION: BACKGROUND 0.2S;
        }

        .WORD-CELL.FOUND {
            BACKGROUND: #22C55E;
            COLOR: #FFFFFF;
            BORDER-COLOR: #16A34A;
        }

        .WORD-BANK {
            DISPLAY: FLEX;
            JUSTIFY-CONTENT: CENTER;
            GAP: 1REM;
            FLEX-WRAP: WRAP;
            MARGIN-TOP: 0.5REM;
            FONT-WEIGHT: BOLD;
        }

        .WORD-ITEM {
            BACKGROUND: #E0E7FF;
            PADDING: 0.3REM 0.6REM;
            BORDER-RADIUS: 6PX;
            COLOR: #3730A3;
        }

        .WORD-ITEM.DONE {
            BACKGROUND: #DCFCE7;
            COLOR: #15803D;
            TEXT-DECORATION: LINE-THROUGH;
        }

        /* CRUZADINHA ADAPTADA */
        .CROSSWORD-ITEM {
            MARGIN-BOTTOM: 1REM;
            BACKGROUND: #FFFFFF;
            PADDING: 0.8REM;
            BORDER-RADIUS: 8PX;
            BORDER: 1PX SOLID VAR(--BORDER-COLOR);
        }

        .CROSSWORD-ITEM LABEL {
            FONT-WEIGHT: BOLD;
            DISPLAY: BLOCK;
            MARGIN-BOTTOM: 0.3REM;
        }

        .ACTIONS {
            MARGIN-TOP: 1.5REM;
            DISPLAY: FLEX;
            JUSTIFY-CONTENT: SPACE-BETWEEN;
            ALIGN-ITEMS: CENTER;
            FLEX-WRAP: WRAP;
            GAP: 1REM;
        }

        .BTN {
            BACKGROUND-COLOR: VAR(--PRIMARY-COLOR);
            COLOR: WHITE;
            BORDER: NONE;
            PADDING: 0.8REM 1.5REM;
            BORDER-RADIUS: 8PX;
            FONT-SIZE: 1REM;
            FONT-WEIGHT: BOLD;
            CURSOR: POINTER;
        }

        .BTN:HOVER {
            OPACITY: 0.9;
        }

        .FEEDBACK {
            FONT-WEIGHT: BOLD;
            FONT-SIZE: 1REM;
        }

        .FEEDBACK.CORRECT { COLOR: VAR(--SUCCESS-COLOR); }
        .FEEDBACK.INCORRECT { COLOR: VAR(--DANGER-COLOR); }
    </style>
</head>
<body>

    <div CLASS="CONTAINER">
        <header>
            <h1>🎈 OFICINA DIGITAL DA TURMA! 🎈</h1>
            <p>FAÇA CADA ETAPA COM ATENÇÃO PARA AVANÇAR.</p>
        </header>

        <div CLASS="PROGRESS-CONTAINER">
            <div CLASS="PROGRESS-BAR" ID="PROGRESS-BAR"></div>
        </div>

        <!-- NAVEGAÇÃO EM 5 ABAS -->
        <nav CLASS="TABS-NAV">
            <button CLASS="TAB-BTN ACTIVE UNLOCKED" DATA-TAB="1" ID="TAB-BTN-1">1. 🌐 USAR A INTERNET</button>
            <button CLASS="TAB-BTN" DATA-TAB="2" ID="TAB-BTN-2">2. ❤️ RESPEITO E AMIZADE</button>
            <button CLASS="TAB-BTN" DATA-TAB="3" ID="TAB-BTN-3">3. 🌳 NOSSO FOLCLORE</button>
            <button CLASS="TAB-BTN" DATA-TAB="4" ID="TAB-BTN-4">4. 🏆 SUPER REVISÃO</button>
            <button CLASS="TAB-BTN" DATA-TAB="5" ID="TAB-BTN-5">5. 📦 AGRUPAMENTO E CALENDÁRIO NEPRE</button>
        </nav>

        <!-- ABA 1: CIDADANIA DIGITAL -->
        <div CLASS="TAB-CONTENT ACTIVE" ID="TAB-1">
            <span CLASS="TAG-THEME TAG-SEGURANCA">CIDADANIA DIGITAL E SEGURANÇA</span>
            <h2>MÓDULO 1: SER UM BOM AMIGO NA INTERNET</h2>
            
            <div CLASS="TEXT-CARD-LIST">
                <div CLASS="TEXT-CARD">
                    <h4>📖 TEXTO DE LEITURA:</h4>
                    <p>USAR A INTERNET COM RESPEITO SIGNIFICA TRATAR TODOS COM CARINHO, NÃO DIZER PALAVRAS FEIAS E PROTEGER NOSSOS SEGREDOS.</p>
                </div>
                <div CLASS="TEXT-CARD">
                    <h4>⌨️ COPIE A FRASE ABAIXO:</h4>
                    <p ID="TARGET-TEXT-CIDADANIA">EU SOU UM BOM AMIGO NA INTERNET.</p>
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>1. ⌨️ PRÁTICA DE DIGITAÇÃO</h3>
                <label FOR="SEGURANCA-Q1"><strong>DIGITE A FRASE IGUALZINHA AO EXEMPLO ACIMA:</strong></label>
                <textarea ID="SEGURANCA-Q1" PLACEHOLDER="DIGITE AQUI..."></textarea>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>2. 🔍 CAÇA-PALAVRAS DA INTERNET SEGURA</h3>
                <p>ENCONTRE E CLIQUE NAS 3 PALAVRAS MÁGICAS NO QUADRO ABAIXO:</p>
                
                <div CLASS="WORD-BANK">
                    <span CLASS="WORD-ITEM" ID="WB-AMOR">💖 AMOR</span>
                    <span CLASS="WORD-ITEM" ID="WB-RESPEITO">🤝 RESPEITO</span>
                    <span CLASS="WORD-ITEM" ID="WB-SENHA">🔒 SENHA</span>
                </div>

                <div CLASS="WORD-GRID" ID="GRID-CIDADANIA">
                    <!-- MONTAGEM VIA JS -->
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>3. 🤝 COMO DEVEMOS TRATAR OS COLEGAS NA INTERNET?</h3>
                <select ID="SEGURANCA-Q2">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="RESPEITO">🤝 COM RESPEITO E CARINHO</OPTION>
                    <OPTION VALUE="BRIGAS">😡 COM BRIGAS E PROVOCAÇÕES</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>4. 🔒 PODEMOS CONTAR NOSSAS SENHAS PARA OS AMIGOS?</h3>
                <select ID="SEGURANCA-Q3">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="NAO">🛑 NÃO! SENHA É UM SEGREDO</OPTION>
                    <OPTION VALUE="SIM">✅ SIM! PODE CONTAR PRA TODOS</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>5. 🚨 SE VOCÊ VIR ALGUÉM SENDO TRATADO MAL NA INTERNET, O QUE FAZER?</h3>
                <select ID="SEGURANCA-Q4">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="AVISAR">📢 AVISAR UM ADULTO OU PROFESSOR</OPTION>
                    <OPTION VALUE="RIR">😆 RIR E COMPARTILHAR</OPTION>
                </select>
            </div>

            <div CLASS="ACTIONS">
                <span CLASS="FEEDBACK" ID="FEEDBACK-1"></span>
                <button CLASS="BTN" ONCLICK="VALIDARABA1()">VALIDAR MÓDULO 1</button>
            </div>
        </div>

        <!-- ABA 2: RESPEITO ÀS MULHERES -->
        <div CLASS="TAB-CONTENT" ID="TAB-2">
            <span CLASS="TAG-THEME TAG-NEPRE">RESPEITO E PROTEÇÃO</span>
            <h2>MÓDULO 2: RESPEITO E A LEI MARIA DA PENHA</h2>

            <div CLASS="TEXT-CARD-LIST">
                <div CLASS="TEXT-CARD NEPRE-CARD">
                    <h4>⌨️ COPIE A FRASE ABAIXO:</h4>
                    <p ID="TARGET-TEXT-NEPRE-GERAL">TODAS AS MULHERES MERECEM RESPEITO E AMOR.</p>
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>1. ⌨️ PRÁTICA DE DIGITAÇÃO</h3>
                <label FOR="NEPRE-Q1"><strong>DIGITE A FRASE EXATAMENTE IGUAL ACIMA:</strong></label>
                <textarea ID="NEPRE-Q1" PLACEHOLDER="DIGITE AQUI..."></textarea>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>2. ✏️ CRUZADINHA DO RESPEITO</h3>
                <p>COMPLETE AS PALAVRAS DA CRUZADINHA COM AS PALAVRAS DO QUADRO:</p>
                <p STYLE="MARGIN-BOTTOM:0.8REM; COLOR:#BE185D; FONT-WEIGHT:BOLD;">BANCO DE PALAVRAS: [ AMOR - LEI - PROTECAO ]</p>

                <div CLASS="CROSSWORD-ITEM">
                    <label FOR="CROSS-1">1. 📜 REGRA QUE AJUDA A PROTEGER AS PESSOAS (3 LETRAS):</label>
                    <input TYPE="TEXT" ID="CROSS-1" PLACEHOLDER="DIGITE AQUI..." MAXLENGTH="3">
                </div>

                <div CLASS="CROSSWORD-ITEM">
                    <label FOR="CROSS-2">2. ❤️ SENTIMENTO BONS QUE DEVEMOS TER POR TODOS (4 LETRAS):</label>
                    <input TYPE="TEXT" ID="CROSS-2" PLACEHOLDER="DIGITE AQUI..." MAXLENGTH="4">
                </div>

                <div CLASS="CROSSWORD-ITEM">
                    <label FOR="CROSS-3">3. 🛡️ CUIDADO PARA MANTER A PESSOA SEGURA (8 LETRAS):</label>
                    <input TYPE="TEXT" ID="CROSS-3" PLACEHOLDER="DIGITE AQUI..." MAXLENGTH="8">
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>3. 🛡️ PARA QUE FOI CRIADA A LEI MARIA DA PENHA?</h3>
                <select ID="NEPRE-Q2">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="PROTEGER">👩‍👧 PARA PROTEGER AS MULHERES</OPTION>
                    <OPTION VALUE="BRINCAR">🎉 PARA FAZER FESTAS</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>4. 🤝 DE QUEM É O DEVER DE RESPEITAR AS MULHERES?</h3>
                <select ID="NEPRE-Q3">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="TODOS">🌍 DE TODAS AS PESSOAS</OPTION>
                    <OPTION VALUE="NINGUEM">❌ DE NINGUÉM</OPTION>
                </select>
            </div>

            <div CLASS="ACTIONS">
                <span CLASS="FEEDBACK" ID="FEEDBACK-2"></span>
                <button CLASS="BTN" ONCLICK="VALIDARABA2()">VALIDAR MÓDULO 2</button>
            </div>
        </div>

        <!-- ABA 3: FOLCLORE BRASILEIRO -->
        <div CLASS="TAB-CONTENT" ID="TAB-3">
            <span CLASS="TAG-THEME TAG-FOLCLORE">NOSSA CULTURA</span>
            <h2>MÓDULO 3: PERSONAGENS DO FOLCLORE BRASILEIRO</h2>

            <div CLASS="ACTIVITY-BOX">
                <h3>1. 🦶 QUEM TEM OS PÉS VOLTADOS PARA TRÁS E PROTEGE A FLORESTA?</h3>
                <select ID="FOLCLORE-Q1">
                    <OPTION VALUE="">-- ESCOLHA O PERSONAGEM COM A FIGURA --</OPTION>
                    <OPTION VALUE="CURUPIRA">🧑‍🦰 CURUPIRA (O PROTETOR DAS ÁRVORES)</OPTION>
                    <OPTION VALUE="SACI">🧢 SACI-PERERÊ (MENINO DE UMA PERNA SÓ)</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>2. ⌨️ DIGITAÇÃO SOBRE O SACI:</h3>
                <div CLASS="TEXT-CARD FOLCLORE-CARD" STYLE="MARGIN: 0.5REM 0;">
                    <p ID="TARGET-TEXT-SACI">O SACI USA UM GORRO VERMELHO.</p>
                </div>
                <label FOR="FOLCLORE-Q2"><strong>DIGITE A FRASE ACIMA:</strong></label>
                <textarea ID="FOLCLORE-Q2" PLACEHOLDER="DIGITE AQUI..."></textarea>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>3. 🔍 CAÇA-PALAVRAS DO FOLCLORE</h3>
                <p>ENCONTRE OS 3 PERSONAGENS NO QUADRO:</p>
                
                <div CLASS="WORD-BANK">
                    <span CLASS="WORD-ITEM" ID="WB-SACI">🧢 SACI</span>
                    <span CLASS="WORD-ITEM" ID="WB-IARA">🧜‍♀️ IARA</span>
                    <span CLASS="WORD-ITEM" ID="WB-BOTO">🐬 BOTO</span>
                </div>

                <div CLASS="WORD-GRID" ID="GRID-FOLCLORE">
                    <!-- MONTAGEM VIA JS -->
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>4. ⌨️ DIGITAÇÃO SOBRE A IARA:</h3>
                <div CLASS="TEXT-CARD FOLCLORE-CARD" STYLE="MARGIN: 0.5REM 0;">
                    <p ID="TARGET-TEXT-IARA">A IARA E UMA SEREIA DO RIO.</p>
                </div>
                <label FOR="FOLCLORE-Q4"><strong>DIGITE A FRASE ACIMA:</strong></label>
                <textarea ID="FOLCLORE-Q4" PLACEHOLDER="DIGITE AQUI..."></textarea>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>5. 🔥 O QUE A MULA SEM CABEÇA SOLTA NO LUGAR DA CABEÇA?</h3>
                <select ID="FOLCLORE-Q5">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA COM A FIGURA --</OPTION>
                    <OPTION VALUE="FOGO">🔥 FOGO E CHAMAS</OPTION>
                    <OPTION VALUE="AGUA">💧 ÁGUA DOCE</OPTION>
                </select>
            </div>

            <div CLASS="ACTIONS">
                <span CLASS="FEEDBACK" ID="FEEDBACK-3"></span>
                <button CLASS="BTN" ONCLICK="VALIDARABA3()">VALIDAR MÓDULO 3</button>
            </div>
        </div>

        <!-- ABA 4: SUPER REVISÃO -->
        <div CLASS="TAB-CONTENT" ID="TAB-4">
            <span CLASS="TAG-THEME TAG-REVISAO">SUPER DESAFIO FINAL</span>
            <h2>MÓDULO 4: REVISANDO TUDO O QUE APRENDEMOS!</h2>
            <p STYLE="MARGIN-BOTTOM: 1REM;">MOSTRE QUE VOCÊ FICOU FERA RESPONDENDO ÀS 10 ATIVIDADES ABAIXO!</p>

            <div CLASS="ACTIVITY-BOX">
                <h3>1. ⌨️ DIGITAÇÃO DA TURMA</h3>
                <div class="TEXT-CARD REVISAO-CARD" style="margin-bottom:0.5rem;">
                    <p ID="TARGET-TEXT-REV">RESPEITO E CARINHO NA INTERNET E NA VIDA.</p>
                </div>
                <label FOR="REV-Q1"><strong>DIGITE A FRASE ACIMA IGUALZINHO:</strong></label>
                <textarea ID="REV-Q1" PLACEHOLDER="DIGITE AQUI..."></textarea>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>2. 🌐 O QUE SIGNIFICA ESTE SÍMBOLO DA INTERNET? 🔒</h3>
                <select ID="REV-Q2">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA --</OPTION>
                    <OPTION VALUE="SENHA">🔒 SENHA SEGURA E PRIVADA</OPTION>
                    <OPTION VALUE="JOGO">🎮 JOGO LIBERADO PARA TODOS</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>3. 🔍 CAÇA-PALAVRAS DA AMIZADE</h3>
                <p>CLIQUE NAS 2 PALAVRAS MÁGICAS NO QUADRO:</p>

                <div CLASS="WORD-BANK">
                    <span CLASS="WORD-ITEM" ID="WB-AMIGO">👦 AMIGO</span>
                    <span CLASS="WORD-ITEM" ID="WB-UNIAO">🤝 UNIAO</span>
                </div>

                <div CLASS="WORD-GRID" ID="GRID-REVISAO">
                    <!-- MONTAGEM VIA JS -->
                </div>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>4. ❓ VERDADEIRO OU FALSO: PODE DIZER MENTIRAS SOBRE OS COLEGAS NA INTERNET?</h3>
                <select ID="REV-Q4">
                    <OPTION VALUE="">-- ESCOLHA A RESPOSTA --</OPTION>
                    <OPTION VALUE="FALSO">❌ FALSO! DEVEMOS DIZER APENAS A VERDADE</OPTION>
                    <OPTION VALUE="VERDADEIRO">✅ VERDADEIRO! PODE DIZER QUALQUER COISA</OPTION>
                </select>
            </div>

            <div CLASS="ACTIVITY-BOX">
                <h3>5. ✏️ MINI CRUZADINHA DOS PERSONAGENS</h3>
                <p>COMPLETE COM OS NOMES DOS PERSONAGENS:</p>
                <p STYLE="MARGIN-BOTTOM:0.8REM; COLOR:#15803D; FONT-WEIGHT:BOLD;">BANCO DE PALAVRAS: [ SACI - IARA ]</p>

