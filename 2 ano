                FEEDBACK.textContent = "CONFIRA SUAS RESPOSTAS SOBRE O CALENDÁRIO NEPRE!";
                FEEDBACK.className = "FEEDBACK INCORRECT";
                return;
            }

            if (foundWordsNepre.size < 2) {
                FEEDBACK.textContent = "ENCONTRE AS 2 PALAVRAS NO CAÇA-PALAVRAS DA QUESTÃO 8!";
                FEEDBACK.className = "FEEDBACK INCORRECT";
                return;
            }

            FEEDBACK.textContent = "PARABÉNS! VOCÊ COMPLETOU TODAS AS ATIVIDADES DA OFICINA DIGITAL COM SUCESSO! 🎉";
            FEEDBACK.className = "FEEDBACK CORRECT";
            document.getElementById('TAB-BTN-5').classList.add('COMPLETED');
            UPDATEPROGRESS();
        }
    </script>
