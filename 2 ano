            if (!UNLOCKEDTABS[TABNUMBER]) return;

            document.querySelectorAll('.TAB-BTN').forEach(btn => btn.classList.remove('ACTIVE'));
            document.getElementById(`TAB-BTN-${TABNUMBER}`).classList.add('ACTIVE');

            document.querySelectorAll('.TAB-CONTENT').forEach(content => content.classList.remove('ACTIVE'));
            document.getElementById(`TAB-${TABNUMBER}`).classList.add('ACTIVE');
        }

        document.querySelectorAll('.TAB-BTN').forEach(btn => {
            btn.addEventListener('click', () => {
                const TABNUMBER = parseInt(btn.getAttribute('DATA-TAB'));
                SWITCHTAB(TABNUMBER);
            });
        });

        function UNLOCKTAB(TABNUMBER) {
            UNLOCKEDTABS[TABNUMBER] = true;
            const btn = document.getElementById(`TAB-BTN-${TABNUMBER}`);
            btn.classList.add('UNLOCKED');
