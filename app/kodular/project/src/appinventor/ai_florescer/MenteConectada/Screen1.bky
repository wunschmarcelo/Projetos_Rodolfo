  <block type="component_event" id="florescer_17" x="20" y="650">
    <mutation component_type="Form" is_generic="false" instance_name="Screen1" event_name="BackPressed" />
    <field name="COMPONENT_SELECTOR">Screen1</field>
    <statement name="DO">
      <block type="component_method" id="florescer_18">
        <mutation component_type="WebViewer" method_name="EvaluateJS" is_generic="false" instance_name="WebViewer1" />
        <field name="COMPONENT_SELECTOR">WebViewer1</field>
        <value name="ARG0">
          <block type="text" id="florescer_19">
            <field name="TEXT">(() =&gt; {const d=document.querySelector('dialog[open]');if(d){d.close();return;}const tab=document.querySelector('[data-tab=checkin]');if(tab &amp;&amp; !tab.classList.contains('active')){tab.click();return;}(window.Kodular || window.AppInventor).setWebViewString('confirm-exit');})()</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
